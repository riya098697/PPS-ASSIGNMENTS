#include <stdio.h>

// Function prototype (declaration) for factorial without recursion
unsigned long long factorialIterative(int n);

// Function prototype (declaration) for factorial with recursion
unsigned long long factorialRecursive(int n);

int main() {
    int num;

    printf("Enter a non-negative integer: ");
    scanf("%d", &num);

    if (num < 0) {
        printf("Factorial is not defined for negative numbers.\n");
    } else {
        unsigned long long iterResult = factorialIterative(num);
        unsigned long long recResult = factorialRecursive(num);

        printf("\n--- Using Iterative Function (Without Recursion) ---\n");
        printf("Factorial of number=%llu\n", iterResult);

        printf("\n--- Using Recursive Function (With Recursion) ---\n");
        printf("Factorial of number=%llu\n", recResult);
    }

    return 0;
}

// Function definition: Without recursion (using a loop)
unsigned long long factorialIterative(int n) {
    unsigned long long fact = 1;
    for (int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

// Function definition: With recursion
unsigned long long factorialRecursive(int n) {
    if (n == 0 || n == 1) { // Base case
        return 1;
    }
    return (unsigned long long)n * factorialRecursive(n - 1); // Recursive call
}

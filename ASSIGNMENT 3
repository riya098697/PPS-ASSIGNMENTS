#include <stdio.h>

int main() {
    int num1, num2, choice;
    int result;

    // Input two numbers
    printf("Enter two numbers: ");
    scanf("%d %d", &num1, &num2);

    // Display menu for arithmetic operations
    printf("\n--- Arithmetic Operations Menu ---\n");
    printf("1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");
    printf("5. Modulus (Remainder)\n");
    printf("Enter your choice (1-5): ");
    scanf("%d", &choice);

    // Perform operation based on user choice
    switch (choice) {
        case 1:
            result = num1 + num2;
            printf("Addition is=%d\n", result);
            break;

        case 2:
            result = num1 - num2;
            printf("Subtraction is=%d\n", result);
            break;

        case 3:
            result = num1 * num2;
            printf("Multiplication is=%d\n", result);
            break;

        case 4:
            if (num2 != 0) {
                printf("Division is=%.2f\n", (float)num1 / num2);
            } else {
                printf("Error: Division by zero is not allowed.\n");
            }
            break;

        case 5:
            if (num2 != 0) {
                result = num1 % num2;
                printf("Modulus is=%d\n", result);
            } else {
                printf("Error: Modulus by zero is not allowed.\n");
            }
            break;

        default:
            printf("Invalid choice! Please select an option between 1 and 5.\n");
    }

    return 0;
}
